# Copia este archivo como .env y llena los valores (el .env NO se sube a git)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>/
MONGODB_DB=kpop
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto
PORT=3000

# Para `npm test`: puede ser la misma URI de Atlas. Las pruebas usan bases
# separadas (kpop_test_...) que se borran solas; nunca tocan la base "kpop".
MONGODB_URI_TEST=mongodb+srv://<usuario>:<password>@<cluster>/
