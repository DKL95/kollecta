# Copia este archivo como .env y llena los valores (el .env NO se sube a Git).

# --- Obligatorias ---
# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://usuario:contrasena@cluster.mongodb.net/
# Nombre de la base (por defecto: kpop)
MONGODB_DB=kpop
# Texto largo y secreto para firmar los JWT
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto

# --- Opcionales ---
# Puerto del servidor (por defecto 3000)
PORT=3000
# Llave gratuita de https://developers.giphy.com para el buscador de GIFs
GIPHY_API_KEY=
# Origen del frontend en desarrollo para Socket.IO (por defecto http://localhost:5173)
# FRONTEND_URL=http://localhost:5173
# Bitácora: nivel (error, warn, info, http, debug) y carpeta
# LOG_LEVEL=info
# LOG_DIR=logs

# --- Solo para pruebas automáticas (npm test) ---
# Puede ser la misma URI de Atlas: las pruebas usan bases kpop_test_* que se borran solas
MONGODB_URI_TEST=
