{
  "name": "kollecta",
  "private": true,
  "scripts": {
    "postinstall": "npm install --prefix frontend",
    "dev": "concurrently -n api,web -c magenta,cyan \"node --watch server.js\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix frontend",
    "prestart": "npm run build",
    "start": "node server.js",
    "migrar-uploads": "node scripts/migrarUploads.js",
