    "documento": "node scripts/documento/generarDocumento.js",
    "sembrar-demo": "node scripts/demo/sembrarDemo.js",
    "limpiar-demo": "node scripts/demo/limpiarDemo.js",
    "test": "node --test \"tests/*.test.*\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.1",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "marked": "^15.0.12"
  }
}
